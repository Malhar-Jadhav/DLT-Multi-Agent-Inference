__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env

# Datasets are regenerated by the scripts in data/, never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Cluster logs (result files in results/ are committed on purpose)
logs/*
!logs/.gitkeep
*.out
*.err

# Model weights live in the Hugging Face cache, not in the repo
weights/
